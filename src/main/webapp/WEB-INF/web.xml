	</servlet-mapping>

	<!-- (Se pueden agregar más servlets en el futuro) -->


	<!-- Página que se muestra al entrar sin ruta específica -->
	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<!-- Clase que se ejecuta al inicio para crear roles si faltan -->
	<listener>
		<listener-class>com.sumixkids.config.BootstrapListener</listener-class>
	</listener>

	<session-config>
		<session-timeout>1</session-timeout>
		<cookie-config>
			<http-only>true</http-only>
		</cookie-config>
	</session-config>

</web-app>
