<?xml version="1.0" encoding="UTF-8"?>
<!--
	Archivo de configuración principal de la aplicación web.
	Aquí se registran:
	- Parámetros generales.
	- Filtro para asegurar uso de caracteres UTF-8.
	- Las rutas (URL) que atienden los servlets.
	- El archivo inicial (index.jsp).
	- Un "listener" que prepara datos al arrancar (roles).
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
							 http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
		 version="3.1">

	<display-name>sumixkids</display-name>

	<!-- Ruta del archivo de configuración dentro del WAR -->
	<context-param>
		<param-name>app.config.location</param-name>
		<param-value>/WEB-INF/classes/config.properties</param-value>
	</context-param>

	<!-- Nombre del acceso a base de datos configurado en el servidor (si existe) -->
	<resource-ref>
		<description>Pool de conexiones MySQL</description>
		<res-ref-name>jdbc/sumixkidsDS</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>

	<!-- Filtro que garantiza que todo se procese en UTF-8 (acentos correctos) -->
	<filter>
		<filter-name>CharacterEncodingFilter</filter-name>
		<filter-class>org.apache.catalina.filters.SetCharacterEncodingFilter</filter-class>
		<init-param>
			<param-name>encoding</param-name>
			<param-value>UTF-8</param-value>
		</init-param>
		<init-param>
			<param-name>ignore</param-name>
			<param-value>false</param-value>
		</init-param>
		<async-supported>true</async-supported>
	</filter>
	<filter-mapping>
		<filter-name>CharacterEncodingFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<!-- Indica que las páginas JSP usan UTF-8 -->
	<jsp-config>
		<jsp-property-group>
			<url-pattern>*.jsp</url-pattern>
			<page-encoding>UTF-8</page-encoding>
		</jsp-property-group>
	</jsp-config>

	<!-- Lista de servlets (clases Java que responden a ciertas direcciones) -->
	<servlet>
		<servlet-name>LoginServlet</servlet-name>
		<servlet-class>com.sumixkids.web.LoginServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet-mapping>
		<servlet-name>LoginServlet</servlet-name>
		<url-pattern>/login</url-pattern>
	</servlet-mapping>

