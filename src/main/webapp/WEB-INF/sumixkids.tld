<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
    
    <tlib-version>1.0</tlib-version>
    <short-name>util</short-name>
    <uri>http://sumixkids.com/functions</uri>
    
    <function>
        <name>formatearFecha</name>
        <function-class>com.sumixkids.util.FechaUtil</function-class>
        <function-signature>java.lang.String formatear(java.time.LocalDateTime)</function-signature>
    </function>
    
    <function>
        <name>formatearFechaHTML</name>
        <function-class>com.sumixkids.util.FechaUtil</function-class>
        <function-signature>java.lang.String formatearHTML(java.time.LocalDateTime)</function-signature>
    </function>
    
    <function>
        <name>truncate</name>
        <function-class>com.sumixkids.util.StringUtil</function-class>
        <function-signature>java.lang.String truncate(java.lang.String, int)</function-signature>
    </function>
    
    <function>
        <name>capitalize</name>
        <function-class>com.sumixkids.util.StringUtil</function-class>
        <function-signature>java.lang.String capitalize(java.lang.String)</function-signature>
    </function>
    
    <function>
        <name>isEmpty</name>
        <function-class>com.sumixkids.util.StringUtil</function-class>
        <function-signature>boolean isEmpty(java.lang.String)</function-signature>
    </function>
    
    <function>
        <name>isNotEmpty</name>
        <function-class>com.sumixkids.util.StringUtil</function-class>
        <function-signature>boolean isNotEmpty(java.lang.String)</function-signature>
    </function>
    
    <function>
        <name>escapeJs</name>
        <function-class>com.sumixkids.util.StringUtil</function-class>
        <function-signature>java.lang.String escapeJs(java.lang.String)</function-signature>
    </function>
</taglib>
