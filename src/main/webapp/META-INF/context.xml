<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!-- DataSource JNDI para Tomcat (ajusta usuario/clave si aplica) -->
    <Resource name="jdbc/sumixkidsDS"
              auth="Container"
              type="javax.sql.DataSource"
              factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/sumixkids?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"
              username="root"
              password=""
              maxActive="20"
              maxIdle="10"
              minIdle="2"
              initialSize="2"
              testOnBorrow="true"
              validationQuery="SELECT 1"/>
</Context>
